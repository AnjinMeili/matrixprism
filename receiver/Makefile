CXXFLAGS=-Wall -Wextra -O3 -g -std=c++11 -D_FILE_OFFSET_BITS=64
OBJECTS=matrix-dmx.o dmx_protocol.o wled_compat.o stream_store.o udp_socket.o
BINARIES=matrix-dmx scene-tool

RGB_INCDIR=matrix/include
RGB_LIBDIR=matrix/lib
RGB_LIBRARY_NAME=rgbmatrix
RGB_LIBRARY=$(RGB_LIBDIR)/lib$(RGB_LIBRARY_NAME).a

LDFLAGS+=-L$(RGB_LIBDIR) -l$(RGB_LIBRARY_NAME) \
          -lrt -lm -pthread

all : matrix-dmx scene-tool

scene-tool : scene-tool.o stream_store.o
	$(CXX) $(CXXFLAGS) $^ -pthread -o $@

matrix-dmx : $(OBJECTS) $(RGB_LIBRARY)
	$(CXX) $(CXXFLAGS) $(OBJECTS) -o $@ $(LDFLAGS)

$(RGB_LIBRARY): FORCE
	$(MAKE) -C $(RGB_LIBDIR)

# Header dependencies are generated by the compiler alongside each object.
%.o : %.cc
	$(CXX) -I$(RGB_INCDIR) $(CXXFLAGS) -MMD -MP -c -o $@ $<

-include $(OBJECTS:.o=.d) scene-tool.d

clean:
	rm -f $(OBJECTS) scene-tool.o $(OBJECTS:.o=.d) scene-tool.d $(BINARIES)
	$(MAKE) -C $(RGB_LIBDIR) clean
	rm -f dmx_protocol_test stream_store_test

test: scene-tool
	$(CXX) $(CXXFLAGS) dmx_protocol.cc wled_compat.cc udp_socket.cc dmx_protocol_test.cc -pthread -o dmx_protocol_test
	./dmx_protocol_test
	rm -f dmx_protocol_test
	$(CXX) $(CXXFLAGS) stream_store.cc stream_store_test.cc -pthread -o stream_store_test
	./stream_store_test
	rm -f stream_store_test
	sh scene_tool_test.sh

FORCE:

.PHONY: all clean FORCE test
